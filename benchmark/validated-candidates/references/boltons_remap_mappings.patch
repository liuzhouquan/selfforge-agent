diff --git a/tests/test_dictutils.py b/tests/test_dictutils.py
index f42bf5b..32d71cf 100644
--- a/tests/test_dictutils.py
+++ b/tests/test_dictutils.py
@@ -678,3 +678,10 @@ def test_frozendict_api():
 
     import copy
     assert copy.copy(fd) is fd
+
+
+def test_frozendict_copy_returns_self():
+    fd = FrozenDict({'a': 1})
+    copied = fd.copy()
+    assert isinstance(copied, FrozenDict)
+    assert copied is fd
diff --git a/tests/test_iterutils.py b/tests/test_iterutils.py
index e3d0695..ec01510 100644
--- a/tests/test_iterutils.py
+++ b/tests/test_iterutils.py
@@ -780,3 +780,20 @@ def test_frange_xfrange_zero_step():
         frange(10, step=0)
     with pytest.raises(ValueError):
         list(xfrange(10, step=0))
+
+
+def test_remap_frozendict():
+    from boltons.dictutils import FrozenDict
+    fd = FrozenDict({'a': 1, 'b': 2})
+    res = remap(fd)
+    assert isinstance(res, FrozenDict)
+    assert res == fd
+
+
+def test_remap_ordered_multidict():
+    from boltons.dictutils import OrderedMultiDict
+    omd = OrderedMultiDict([('k', 1), ('k', 2), ('x', 3)])
+    res = remap(omd)
+    assert isinstance(res, OrderedMultiDict)
+    assert res.getlist('k') == [1, 2]
+    assert res.getlist('x') == [3]
