 class UnknownFunctionError(JMESPathError):
-    pass
+    def __init__(self, function_name, similar=None):
+        if function_name.startswith("Unknown function: ") and function_name.endswith("()"):
+            self.function_name = function_name[len("Unknown function: "):-2]
+        else:
+            self.function_name = function_name
+        self.similar = similar
+        if similar:
+            msg = ("Unknown function: %s(), did you mean: %s()?"
