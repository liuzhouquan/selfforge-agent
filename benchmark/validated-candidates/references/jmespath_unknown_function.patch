 from jmespath import exceptions
+from jmespath import functions
 
 
 class TestFunctions(unittest.TestCase):
@@ -55,3 +56,29 @@ class TestFunctions(unittest.TestCase):
         self.assertEqual(
             str(exception),
             'Expected at least 1 argument for function not_null(), received 0')
+
+    def test_unknown_function_suggestion(self):
+        fn = functions.Functions()
+        with self.assertRaises(exceptions.UnknownFunctionError) as cm:
+            fn.call_function('starts_wit', [])
+        err = cm.exception
+        self.assertEqual(err.function_name, 'starts_wit')
+        self.assertEqual(err.similar, 'starts_with')
+        self.assertIn("Unknown function: starts_wit(), did you mean: starts_with()?", str(err))
+
+    def test_unknown_function_without_suggestion(self):
+        fn = functions.Functions()
+        with self.assertRaises(exceptions.UnknownFunctionError) as cm:
+            fn.call_function('completely_nonexistent_xyz', [])
+        err = cm.exception
+        self.assertEqual(err.function_name, 'completely_nonexistent_xyz')
+        self.assertIsNone(err.similar)
+        self.assertEqual(str(err), "Unknown function: completely_nonexistent_xyz()")
+
+    def test_unknown_function_suggest_disabled(self):
+        fn = functions.Functions()
+        with self.assertRaises(exceptions.UnknownFunctionError) as cm:
+            fn.call_function('starts_wit', [], suggest=False)
+        err = cm.exception
+        self.assertIsNone(err.similar)
+        self.assertEqual(str(err), "Unknown function: starts_wit()")
