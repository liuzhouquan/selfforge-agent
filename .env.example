# Optional: only the legacy POST /review endpoint needs a local repository.
VERIFIED_PR_AGENT_REPO_ROOT=/absolute/path/to/trusted/repository

# Optional coding-agent settings. Never commit a populated .env file.
VPA_MODEL=
VPA_API_BASE_URL=
VPA_API_KEY=

# Model providers for web PR review and repair. Set either or both.
DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=
VPA_DEEPSEEK_MODEL=deepseek-flash
VPA_OPENROUTER_MODEL=openai/gpt-4.1-mini

# Set to 1 only when you are willing to run trusted PR pytest code on this host.
VPA_ENABLE_HOST_TESTS=0
